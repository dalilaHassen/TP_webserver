<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>test</display-name>

    <!-- ===== Filters (one registration method: web.xml) ===== -->
    <filter>
        <filter-name>LoggingFilter</filter-name>
        <filter-class>filters.LoggingFilter</filter-class>
        <init-param>
            <param-name>logPrefix</param-name>
            <param-value>[MyApp-LOG]</param-value>
        </init-param>
    </filter>

    <filter>
        <filter-name>SecurityFilter</filter-name>
        <filter-class>filters.SecurityFilter</filter-class>
    </filter>

    <!-- The ORDER of the mappings = the execution order -->
    <filter-mapping>
        <filter-name>LoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/ListItems</url-pattern>
    </filter-mapping>

    <!-- ===== Listener configured in web.xml (the others use @WebListener) ===== -->
    <listener>
        <listener-class>listeners.RequestListener</listener-class>
    </listener>

    <!-- ===== Servlets ===== -->
    <servlet>
        <servlet-name>FormServlet</servlet-name>
        <servlet-class>servlets.PersonServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FormServlet</servlet-name>
        <url-pattern>/FormServlet</url-pattern>
        <url-pattern>/Form_Servlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReadCookie</servlet-name>
        <servlet-class>servlets.ReadCookie</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReadCookie</servlet-name>
        <url-pattern>/ReadCookie</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VisitCounter</servlet-name>
        <servlet-class>servlets.VisitCounter</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VisitCounter</servlet-name>
        <url-pattern>/VisitCounter</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShowSession</servlet-name>
        <servlet-class>servlets.ShowSession</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShowSession</servlet-name>
        <url-pattern>/ShowSession</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ListItems</servlet-name>
        <servlet-class>servlets.ListItems</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ListItems</servlet-name>
        <url-pattern>/ListItems</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlets.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>servlets.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RemoveUser</servlet-name>
        <servlet-class>servlets.RemoveUser</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RemoveUser</servlet-name>
        <url-pattern>/RemoveUser</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AttributeTest</servlet-name>
        <servlet-class>servlets.AttributeTest</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttributeTest</servlet-name>
        <url-pattern>/AttributeTest</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Controller</servlet-name>
        <servlet-class>lab.mvc.controller.Controller</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Controller</servlet-name>
        <url-pattern>/Controller</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
